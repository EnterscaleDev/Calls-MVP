# Copy to .env.local (already gitignored) and fill in real values there.
# Never commit real secrets — .env.local is for your machine only.

# --- SendChamp (real telephony provider — see lib/server/sendchamp.ts) ---
# Secret. Server-side only — never reference this from client code or a
# NEXT_PUBLIC_-prefixed var, or it ships in the browser bundle.
SENDCHAMP_API_KEY=

# Not secret — the account's base API URL, confirmed in their dashboard.
SENDCHAMP_BASE_URL=https://api.sendchamp.com/api/v1

# The Virtual Number you purchased in the SendChamp dashboard, in E.164
# format (e.g. +2341234567). This is the "from" leg for outbound calls.
SENDCHAMP_VIRTUAL_NUMBER=

# --- Africa's Talking (real telephony provider — see lib/server/africastalking.ts) ---
# Secret. Server-side only — same rule as above, never client-exposed.
AFRICASTALKING_API_KEY=

# "sandbox" in their dev environment; your app's specific username in
# production (see their Authentication docs).
AFRICASTALKING_USERNAME=

# The Virtual Number you purchased in the Africa's Talking dashboard, in
# E.164 format (e.g. +254711XXXYYY). Also where you register the callback
# URL below, in their dashboard — not passed per-request.
AFRICASTALKING_VIRTUAL_NUMBER=

# Full public URL this app is reachable at. Used two ways: (1) you register
# <this>/api/africastalking/callback as this number's Voice callback URL in
# their dashboard, and (2) it's not otherwise sent per-request. Must be
# publicly reachable — won't work against plain localhost without a tunnel
# (ngrok etc.) during local testing.
APP_PUBLIC_URL=
